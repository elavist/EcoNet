@echo off
REM Скрипт для запуска всех тестов через TestEngine
REM Использует нейронную архитектуру для координации тестов

chcp 65001 >nul
echo ============================================================
echo   Запуск всех тестов через TestEngine
echo ============================================================
echo.

cd /d "%~dp0\.."
python tests\run_all_via_test_engine.py

if errorlevel 1 (
    echo.
    echo ОШИБКА при запуске тестов через TestEngine!
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   Тесты завершены
echo ============================================================
pause

